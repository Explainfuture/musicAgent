{
  "name": "musicagent",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "electron": "concurrently -k \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:dev": "npm run electron",
    "electron:start": "concurrently -k \"next start\" \"wait-on http://localhost:3000 && electron .\"",
    "icon": "node scripts/make-icon.mjs",
    "dist:win": "npm run icon && electron-builder --win --x64",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.mjs",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "electron": "^42.0.0",
    "electron-builder": "^26.8.1",
    "playwright": "^1.60.0",
    "png-to-ico": "^3.0.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.explainsf.ccsongs",
    "productName": "ccSongs",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
